# ---- Database ----
DATABASE_URL=mysql://root:@localhost:3306/vote

# ---- Server ----
PORT=3000
# ใช้เซ็น session token และลิงก์กลุ่ม (สุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร)
APP_SECRET=change-me-to-a-long-random-string
# URL สาธารณะของ API (ใช้ตอนตั้ง webhook) เช่น https://xxxx.ngrok-free.app
PUBLIC_URL=http://localhost:3000

# ---- LINE Login channel (สำหรับ LIFF) ----
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# ---- LINE Messaging API channel (bot ในกลุ่ม) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- โหมดพัฒนา: ล็อกอินจำลองโดยไม่ต้องใช้ LINE (ปิดอัตโนมัติเมื่อ NODE_ENV=production) ----
DEV_AUTH=true

# ---- คีย์ให้ Scheduled Task เรียก /api/cron?key=... ทุกนาที (สุ่มยาว ๆ) ----
CRON_KEY=

# ---- Web (Vite) ----
VITE_LIFF_ID=
VITE_API_URL=
